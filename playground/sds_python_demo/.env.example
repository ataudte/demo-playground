# Copy this file to .env and fill in values for your SOLIDserver demo environment.
# Keep .env private; it may contain credentials.

# SOLIDserver hostname or IP address.
SDS_HOST=

# SOLIDserver username.
SDS_USER=

# SOLIDserver password for SDS_USER.
SDS_PASSWORD=

# Verify the SOLIDserver TLS certificate.
# Use false for lab systems with self-signed certificates.
SDS_VERIFY_TLS=

# SOLIDserver authentication method.
# Common value: native
SDS_AUTH_METHOD=

# API request timeout in seconds.
SDS_TIMEOUT=

# IPAM space used by the demo flow.
SDS_DEFAULT_SPACE=

# IPv4 subnet prefix requested by step 02.
SDS_DEMO_PREFIX=

# Subnet name used if step 02 is run with --apply.
SDS_DEMO_SUBNET_NAME=

# Hostname used by step 03 when preparing or creating the DNS A record.
SDS_DEMO_HOSTNAME=

# Output JSON file written by step 01.
SDS_OUTPUT_01_IPAM_CONTEXT=

# Output JSON file written by step 02.
SDS_OUTPUT_02_SUBNET_ALLOCATION=

# Output JSON file written by step 03.
SDS_OUTPUT_03_DNS_RECORD=
