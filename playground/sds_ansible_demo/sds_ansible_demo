#!/usr/bin/env python3
"""Prompt once, save configuration, and run the numbered Ansible examples."""

import argparse
import getpass
import importlib.metadata
import ipaddress
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile


ROOT = Path(__file__).resolve().parent
CONFIG = ROOT / "config.json"

# False: short results for recording. True: full Ansible and installation output.
VERBOSE = False

STEPS = {
    "00": ("Connect and list IPAM spaces", "00_connect_and_inventory.yml"),
    "01": ("Inspect the IPAM space and parent network", "01_find_space_and_networks.yml"),
    "02": ("Create the demo network, host address and host A record", "02_create_network_and_address.yml"),
    "03": ("Create the application CNAME alias", "03_publish_dns_record.yml"),
    "04": ("Verify the demo resources and save result.json", "04_verify_and_recap.yml"),
    "05": ("Remove the alias, host A/PTR records, address and empty child network", "05_cleanup.yml"),
}


def ask(label, default="", secret=False, optional=False):
    while True:
        suffix = " [Enter keeps the saved value]" if secret and default else (
            f" [{default}]" if default else "")
        value = (getpass.getpass if secret else input)(f"{label}{suffix}: ")
        if not secret:
            value = value.strip()
        if value:
            return value
        if default or optional:
            return default
        print("A value is required.")


def ask_yes_no(label, default=True):
    while True:
        value = ask(label, "yes" if default else "no").lower()
        if value in ("yes", "y"):
            return True
        if value in ("no", "n"):
            return False
        print("Enter yes or no.")


def default_app_alias(hostname):
    return hostname[:59] + "-app"


def validate(config):
    provider = config["solidserver"]
    if not re.fullmatch(r"[A-Za-z0-9.-]+", provider["host"]):
        raise ValueError("Use a manager hostname or IPv4 address, without https://, port or path.")
    if not provider["username"] or not provider["password"]:
        raise ValueError("A username and password are required.")
    if provider.get("authentication") != "basic":
        raise ValueError("This simple demo uses Basic authentication over HTTPS.")
    if type(provider.get("check_tls")) is not bool:
        raise ValueError("check_tls must be true or false (a JSON boolean).")
    parent = ipaddress.IPv4Network(config["parent_network"], strict=True)
    network = ipaddress.IPv4Network(config["network"], strict=True)
    address = ipaddress.IPv4Address(config["address"])
    if network == parent or not network.subnet_of(parent):
        raise ValueError("The demo network must be a smaller subnet of its parent.")
    if address not in network or address in (network.network_address, network.broadcast_address):
        raise ValueError("The address must be a usable IPv4 address in the demo network.")
    for field in ("space", "network_name", "dns_server"):
        if not re.fullmatch(r"[A-Za-z0-9_.:/ -]+", config[field]):
            raise ValueError(f"Use letters, numbers, spaces or . _ : / - in {field}.")
    label = r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?"
    if not re.fullmatch(label, config["hostname"]):
        raise ValueError("The hostname must be one DNS label.")
    app_alias = config.get("app_alias", default_app_alias(config["hostname"]))
    if not re.fullmatch(label, app_alias) or app_alias.lower() == config["hostname"].lower():
        raise ValueError("The application alias must be a different, valid DNS label.")
    if len(app_alias + "." + config["dns_zone"]) > 253:
        raise ValueError("The application DNS name is too long.")
    if len(config["dns_zone"]) > 253 or not re.fullmatch(label + r"(?:\." + label + r")+", config["dns_zone"]):
        raise ValueError("Enter a forward DNS zone such as demo.example.net.")
    if not 1 <= int(config["ttl"]) <= 2147483647:
        raise ValueError("TTL must be a positive number of seconds.")
    if config.get("ca_file") and not Path(config["ca_file"]).is_file():
        raise ValueError("The CA file does not exist.")


def configure(previous=None):
    previous = previous or {}
    provider = previous.get("solidserver", {})
    print("\nSOLIDserver connection and dedicated demo resources")
    print("The parent network, space, DNS server and default-view zone must already exist.")
    print("Use an unused child network, address, host name and application alias.\n")
    config = {"solidserver": {
        "host": ask("SOLIDserver manager", provider.get("host", "")),
        "username": ask("API username", provider.get("username", "")),
        "password": ask("API password", provider.get("password", ""), secret=True),
        "authentication": "basic", "timeout": 10,
    }}
    config["solidserver"]["check_tls"] = ask_yes_no(
        "Verify TLS certificate (no for a self-signed lab)", provider.get("check_tls", True))
    ca = ""
    if config["solidserver"]["check_tls"]:
        ca = ask("CA bundle path (optional; Enter uses the default trust store)",
                 previous.get("ca_file", ""), optional=True)
    config["ca_file"] = str(Path(ca).expanduser().resolve()) if ca else ""
    for key, label, default in [
        ("space", "IPAM space", "Local"),
        ("parent_network", "Existing parent IPv4 CIDR", ""),
        ("network", "New demo IPv4 CIDR", ""),
        ("network_name", "Demo network name", "ansible-demo-network"),
        ("address", "Demo IPv4 address", ""),
        ("dns_server", "SOLIDserver DNS server or Smart name", ""),
        ("dns_zone", "Existing forward zone (default DNS view)", ""),
        ("hostname", "Demo hostname (one label)", "ansible-demo-host"),
    ]:
        config[key] = ask(label, str(previous.get(key, default)))
    config["dns_zone"] = config["dns_zone"].rstrip(".")
    config["app_alias"] = ask("Application DNS alias (one label)",
                              previous.get("app_alias", default_app_alias(config["hostname"])))
    config["ttl"] = int(ask("DNS TTL in seconds (host and application alias)",
                            str(previous.get("ttl", "300"))))
    validate(config)
    fd, temp_path = tempfile.mkstemp(prefix=".config-", dir=ROOT)
    try:
        with os.fdopen(fd, "w") as handle:
            json.dump(config, handle, indent=2)
            handle.write("\n")
        os.chmod(temp_path, 0o600)
        os.replace(temp_path, CONFIG)
    finally:
        Path(temp_path).unlink(missing_ok=True)
    print("\nSaved config.json with owner-only permissions. Future runs reuse it.\n")
    return config


def environment(config):
    cache = ROOT / '.ansible'
    cache.mkdir(exist_ok=True)
    (cache / 'ansible.cfg').write_text('[defaults]\n')
    env = os.environ.copy()
    env.update({
        "ANSIBLE_CONFIG": str(cache / 'ansible.cfg'),
        "ANSIBLE_HOME": str(ROOT / ".ansible/home"),
        "ANSIBLE_LOCAL_TEMP": str(ROOT / ".ansible/tmp"),
        "ANSIBLE_COLLECTIONS_PATH": str(ROOT / ".ansible/collections"),
        "ANSIBLE_STDOUT_CALLBACK": "default" if VERBOSE else "demo_quiet",
        "ANSIBLE_CALLBACK_PLUGINS": str(ROOT / "callback_plugins"),
        "ANSIBLE_CALLBACKS_ENABLED": "demo_events",
    })
    if not VERBOSE:
        env.update({
            "ANSIBLE_DISPLAY_OK_HOSTS": "false",
            "ANSIBLE_DISPLAY_SKIPPED_HOSTS": "false",
            "ANSIBLE_VERBOSITY": "0",
        })
        if config.get("solidserver", {}).get("check_tls") is False:
            # Match only urllib3's unverified-HTTPS message. A built-in warning
            # category avoids importing urllib3 before Python loads site-packages.
            # Child Ansible workers inherit this filter, including on macOS.
            warning_filter = "ignore:Unverified HTTPS request is being made to host:Warning:urllib3.connectionpool"
            env["PYTHONWARNINGS"] = ",".join(filter(None, [env.get("PYTHONWARNINGS", ""), warning_filter]))
    if sys.platform == "darwin":
        # Set this before starting Ansible; its forked workers inherit it.
        # https://docs.ansible.com/projects/ansible/latest/reference_appendices/faq.html#running-on-macos-as-a-control-node
        env.setdefault("OBJC_DISABLE_INITIALIZE_FORK_SAFETY", "YES")
    if config.get("ca_file"):
        env["REQUESTS_CA_BUNDLE"] = config["ca_file"]
    return env


def install(command, env):
    """Keep successful setup quiet; always show output if a command fails."""
    result = subprocess.run(command, cwd=ROOT, env=env, text=True,
                            stdout=None if VERBOSE else subprocess.PIPE,
                            stderr=None if VERBOSE else subprocess.STDOUT)
    if result.returncode and not VERBOSE and result.stdout:
        print(result.stdout, end="" if result.stdout.endswith("\n") else "\n", flush=True)
    result.check_returncode()


def prepare(env):
    if sys.prefix == sys.base_prefix or not shutil.which("ansible-playbook"):
        raise ValueError("Start the environment first: ansible-env start --project " + str(ROOT))
    try:
        installed = importlib.metadata.version("SOLIDserverRest")
    except importlib.metadata.PackageNotFoundError:
        installed = None
    if installed != "2.14.0":
        print("Installing the SOLIDserver Python dependency...", flush=True)
        install([sys.executable, "-m", "pip", "install", "-r", str(ROOT / "requirements.txt")], env)
    collection = ROOT / ".ansible/collections/ansible_collections/community/efficientip/MANIFEST.json"
    if not collection.is_file() or json.loads(collection.read_text())["collection_info"]["version"] != "1.2.0":
        if not shutil.which("git"):
            raise ValueError("Git is required to install the EfficientIP collection.")
        print("Installing the EfficientIP Ansible collection...", flush=True)
        install(["ansible-galaxy", "collection", "install", "-r", str(ROOT / "requirements.yml"),
                 "-p", str(ROOT / ".ansible/collections"), "--force"], env)
        if not collection.is_file() or json.loads(collection.read_text())["collection_info"]["version"] != "1.2.0":
            raise ValueError("The expected EfficientIP collection was not installed.")


def run(step, env):
    from demo_watch import EventWriter

    title, filename = STEPS[step]
    print(f"\n{step} — {title}", flush=True)
    writer = EventWriter(ROOT)
    if not writer.write("run_start", step=step, title=title, file="examples/" + filename):
        print("Companion view unavailable: cannot write local task events.", file=sys.stderr)
    play_env = dict(env, SDS_DEMO_RUN_ID=writer.run_id)
    try:
        subprocess.run(["ansible-playbook", "-i", "localhost,", str(ROOT / "examples" / filename)],
                       cwd=ROOT, env=play_env, check=True)
    except (subprocess.CalledProcessError, OSError, KeyboardInterrupt) as error:
        writer.write("run_end", status="interrupted" if isinstance(error, KeyboardInterrupt) else "failed")
        raise
    writer.write("run_end", status="complete")
    if not VERBOSE:
        print("  OK\n", flush=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("step", nargs="?", choices=[*STEPS, "run", "config", "watch"],
                        help="00–04: demo steps; 05: cleanup; run: create and verify; config: edit settings; watch: live companion")
    args = parser.parse_args()
    if args.step == "watch":
        from demo_watch import watch
        watch(ROOT)
        return
    os.chdir(ROOT)
    previous = json.loads(CONFIG.read_text()) if CONFIG.exists() else None
    if args.step == "config" or previous is None:
        config = configure(previous)
        if args.step == "config":
            return
    else:
        config = previous
        validate(config)
        os.chmod(CONFIG, 0o600)
    env = environment(config)
    ready = False
    menu_shown = False
    while True:
        choice = args.step
        if choice is None:
            if not menu_shown:
                print(f"SOLIDserver: {config['solidserver']['host']} | space: {config['space']}")
                print(f"Host: {config['hostname']}.{config['dns_zone']} -> {config['address']}")
                print(f"Alias: {config.get('app_alias', default_app_alias(config['hostname']))}.{config['dns_zone']}\n")
                for key, (title, _) in STEPS.items():
                    print(f"  {key}  {title}")
                print("  run Create and verify (00–04)\n  menu Show this menu\n  q   Quit\n")
                menu_shown = True
            choice = input("Choose a step: ").strip().lower()
            if choice in ("q", "quit", "exit"):
                return
            if choice == "menu":
                menu_shown = False
                continue
            if choice not in STEPS and choice != "run":
                print("Choose 00–05, run, menu or q.\n")
                continue
        if not ready:
            prepare(env)
            ready = True
        for step in (["00", "01", "02", "03", "04"] if choice == "run" else [choice]):
            run(step, env)
        if args.step is not None:
            return


if __name__ == "__main__":
    try:
        main()
    except (EOFError, KeyboardInterrupt):
        print("\nStopped.", file=sys.stderr)
        raise SystemExit(130)
    except subprocess.CalledProcessError as error:
        print("Step failed. Inspect the Ansible error and actual state before continuing.", file=sys.stderr)
        raise SystemExit(error.returncode)
    except (ValueError, KeyError, OSError) as error:
        # Avoid exposing malformed configuration values or credentials in tracebacks.
        message = str(error) if isinstance(error, ValueError) and not isinstance(error, json.JSONDecodeError) else "Cannot read or use the configuration. Run ./sds_ansible_demo config to review it."
        print(message, file=sys.stderr)
        raise SystemExit(1)
