#!/usr/bin/env bash
set -euo pipefail

tool_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
action="${1:-start}"
if [[ $# -gt 0 ]]; then shift; fi
project="$PWD"
profile=''
while [[ $# -gt 0 ]]; do
  case "$1" in
    --project) [[ $# -ge 2 ]] || exit 2; project="$2"; shift 2 ;;
    --requirements) [[ $# -ge 2 ]] || exit 2; profile="$2"; shift 2 ;;
    --) shift; break ;;
    *) break ;;
  esac
done

fail() { printf '%s\n' "$*" >&2; exit 1; }
case "$action" in
  help|-h|--help)
    cat <<'HELP'
Usage: ansible-env COMMAND [--project DIR] [--requirements FILE] [-- COMMAND ARGS]
Commands: start, setup, check, status, repair, exec

The current directory is the default project. Its .venv is reused or created
with an existing Python 3.12, 3.13 or 3.14 interpreter. Additional requirements
are optional and relative to the selected project. Type exit or stop to leave
the prepared shell. No Python interpreter is downloaded.
HELP
    exit 0 ;;
  setup|start|check|status|repair|exec) ;;
  *) fail "Unknown command: $action; run ansible-env help." ;;
esac
[[ -d "$project" ]] || fail 'Create the project directory before starting an environment.'
project="$(cd -- "$project" && pwd -P)"
cd "$project"
if [[ -n "$profile" ]]; then
  [[ -f "$profile" ]] || fail "Requirements file not found: $profile"
  profile="$(cd -- "$(dirname -- "$profile")" && pwd -P)/$(basename -- "$profile")"
fi
if [[ "$action" == 'start' ]]; then
  [[ -t 0 && -t 1 ]] || fail 'Use start in a terminal; use exec for a one-shot command.'
  [[ "${ANSIBLE_ENV_ACTIVE_PROJECT:-}" != "$project" ]] || { printf '%s\n' 'This environment is already active.'; exit 0; }
fi
if [[ "$action" == 'exec' ]]; then [[ $# -gt 0 ]] || fail 'Supply a command after --.'; fi

venv_python="$project/.venv/bin/python"
if [[ "$action" == 'status' ]]; then
  [[ -x "$venv_python" ]] || { printf '%s\n' 'No environment yet. Run ansible-env setup in this project.'; exit 0; }
  exec "$venv_python" "$tool_root/scripts/runtime.py"
fi

if [[ ! -x "$venv_python" ]]; then
  base_python="${ANSIBLE_ENV_PYTHON:-python3}"
  command -v "$base_python" >/dev/null 2>&1 || fail 'Select an installed Python using ANSIBLE_ENV_PYTHON=/path/to/python3.'
  "$base_python" "$tool_root/scripts/runtime.py" --python-only
  printf '%s\n' 'Creating the project environment...'
  "$base_python" -m venv "$project/.venv"
fi
"$venv_python" "$tool_root/scripts/runtime.py" --python-only
mkdir -p "$project/.ansible-env/tmp" "$project/.ansible-env/home"
export TMPDIR="$project/.ansible-env/tmp"
if ! "$venv_python" -m pip --version >/dev/null 2>&1; then "$venv_python" -m ensurepip; fi
if ! "$venv_python" -c 'import importlib.metadata as m; assert m.version("pip") == "26.2.2"' >/dev/null 2>&1; then
  "$venv_python" -m pip install --quiet --disable-pip-version-check 'pip==26.2.2'
fi
requirement_args=(-r "$tool_root/requirements-base.txt")
check_args=("$tool_root/requirements-base.txt")
if [[ -n "$profile" ]]; then requirement_args+=(-r "$profile"); check_args+=("$profile"); fi
if [[ "$action" == 'repair' ]]; then
  "$venv_python" -m pip install --quiet --disable-pip-version-check --force-reinstall "${requirement_args[@]}"
elif ! "$venv_python" "$tool_root/scripts/requirements_ok.py" "${check_args[@]}"; then
  printf '%s\n' 'Installing required packages...'
  "$venv_python" -m pip install --quiet --disable-pip-version-check "${requirement_args[@]}"
fi
"$venv_python" "$tool_root/scripts/runtime.py" --quiet
export VIRTUAL_ENV="$project/.venv"
export PATH="$VIRTUAL_ENV/bin:$PATH"
export ANSIBLE_ENV_PROJECT="$project"
export ANSIBLE_HOME="$project/.ansible-env/home"
export ANSIBLE_LOCAL_TEMP="$project/.ansible-env/tmp"
if [[ -f "$project/ansible.cfg" ]]; then export ANSIBLE_CONFIG="$project/ansible.cfg"; fi
case "$action" in
  start) exec /bin/bash --noprofile --rcfile "$tool_root/scripts/shell.bash" -i ;;
  setup|repair) exec "$venv_python" "$tool_root/scripts/runtime.py" ;;
  exec) exec "$@" ;;
  check)
    "$venv_python" -m pip check
    interpreter_arg="$("$venv_python" -c 'import json,sys; print(json.dumps({"ansible_python_interpreter":sys.executable}))')"
    exec ansible localhost -i localhost, -c local -m ansible.builtin.ping -e "$interpreter_arg"
    ;;
esac
